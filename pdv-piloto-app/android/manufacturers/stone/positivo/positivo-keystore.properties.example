# Positivo Keystore Configuration - EXEMPLO
# 
# INSTRUÇÕES:
# 1. Copie este arquivo para: positivo-keystore.properties
# 2. Substitua os valores com suas informações reais
# 3. NUNCA commite o arquivo positivo-keystore.properties (está no .gitignore)

# Arquivo do keystore (relativo a este diretório)
storeFile=positivo-keystore.jks

# Senha do armazenamento de chaves
storePassword=YOUR_STORE_PASSWORD_HERE

# Alias da chave
keyAlias=positivo_key

# Senha da chave
keyPassword=YOUR_KEY_PASSWORD_HERE

