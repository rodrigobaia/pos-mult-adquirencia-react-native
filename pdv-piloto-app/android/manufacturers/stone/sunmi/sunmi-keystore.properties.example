# Sunmi Keystore Configuration - EXEMPLO
# 
# INSTRUÇÕES:
# 1. Copie este arquivo para: sunmi-keystore.properties
# 2. Substitua os valores com suas informações reais
# 3. NUNCA commite o arquivo sunmi-keystore.properties (está no .gitignore)

# Arquivo do keystore (relativo a este diretório)
storeFile=sunmi-keystore.jks

# Senha do armazenamento de chaves
storePassword=YOUR_STORE_PASSWORD_HERE

# Alias da chave
keyAlias=sunmi_key

# Senha da chave
keyPassword=YOUR_KEY_PASSWORD_HERE

